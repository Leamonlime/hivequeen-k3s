# hivequeen k3s — environment / secret reference
# Copy to .env (gitignored) or, in production, load these as Kubernetes Secret keys.
# NO real values live here or anywhere in the repo — every value below is a placeholder.
# In the live cluster these are injected into pods via secretKeyRef, with zero inline
# values in the manifests (see manifests/app-deployment.example.yaml).

# --- Cluster / kubeconfig ---
# k3s writes the admin kubeconfig to /etc/rancher/k3s/k3s.yaml on the node.
# It is NEVER committed. Point kubectl at a copy locally instead:
KUBECONFIG=/path/to/your/kubeconfig       # e.g. ~/.kube/hivequeen.yaml

# --- Tailscale (remote access) ---
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx  # one-off auth key to join the tailnet

# --- PostgreSQL (Bitnami chart secret) ---
POSTGRES_HOST=postgres.<namespace>.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-32-char-random

# --- Redis (Bitnami chart secret) ---
REDIS_HOST=redis-master.<namespace>.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=change-me-32-char-random

# --- Ollama (local LLM, runs on the host) ---
OLLAMA_HOST=http://127.0.0.1:11434         # host-local, not exposed off the box
OLLAMA_MODEL=llama3.2

# --- Portainer ---
# Admin password is set on first launch through the web UI, not via env.
PORTAINER_URL=https://<node-ip>:9443
